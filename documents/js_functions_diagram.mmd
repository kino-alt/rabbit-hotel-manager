%% 階層(画面層→画面部品/小さな共通部品→共通ロジック層→純粋モジュール→データアクセス層)を
%% subgraphで明示したレイアウト。詳細な関数一覧・呼び出し関係は function_relationships.md が正。
%% 再生成: npx @mermaid-js/mermaid-cli -i js_functions_diagram.mmd -o js_functions_diagram.png -b white
%% 実線=業務ロジックの本流の依存／点線=esc.js等の汎用ユーティリティ呼び出し(横断的・補助的)
flowchart TB
    subgraph L1["画面層"]
        direction LR
        loginJs["login.js<br/>ログイン画面"]
        mainJs["main.js<br/>全体一覧・メニュー・店舗切替"]
        careJs["care.js<br/>ケア担当画面"]
        runJs["run.js<br/>ラン担当画面・LINE送信"]
        registerJs["register.js<br/>うさぎ登録・編集"]
        adminJs["admin.js<br/>設定画面"]
        historyJs["history.js<br/>過去の記録(閲覧専用)"]
    end

    subgraph L2["画面部品(複数/専用画面で共用)"]
        direction LR
        overviewViewJs["overviewView.js<br/>グリッド描画(共用部品)"]
        registerGridViewJs["registerGridView.js<br/>STEP2グリッド(register専用)"]
    end

    subgraph L3["小さな共通部品(ドメイン知識なし)"]
        direction LR
        escJs["esc.js<br/>HTMLエスケープ"]
        swipeJs["swipe.js<br/>スワイプ判定"]
        toastJs["toast.js<br/>失敗トースト"]
        iconsJs["icons.js<br/>SVGアイコン"]
    end

    subgraph L4["共通ロジック層"]
        direction LR
        authJs["auth.js<br/>認証・設定パスワード照合"]
        scheduleJs["schedule.js<br/>日付計算・状態判定(純粋)"]
        scheduleGridJs["scheduleGrid.js<br/>予定⇄グリッド変換(純粋)"]
        dailyRecordJs["dailyRecord.js<br/>当日記録の生成・更新"]
    end

    subgraph L5["純粋モジュール(テスト対象)"]
        direction LR
        scheduleMergeJs["scheduleMerge.js<br/>予定の3-wayマージ(純粋)"]
        careReconcileJs["careReconcile.js<br/>記録を予定へ整合(純粋)"]
    end

    subgraph L6["データアクセス層"]
        dbJs["db.js<br/>Firestoreの読み書き"]
    end

    %% ===== 業務ロジックの本流(実線) =====
    loginJs --> authJs
    mainJs --> authJs
    mainJs --> overviewViewJs
    careJs --> authJs
    careJs --> dbJs
    careJs --> dailyRecordJs
    careJs --> scheduleJs
    careJs --> overviewViewJs
    runJs --> authJs
    runJs --> dbJs
    runJs --> dailyRecordJs
    runJs --> scheduleJs
    runJs --> overviewViewJs
    registerJs --> authJs
    registerJs --> dbJs
    registerJs --> dailyRecordJs
    registerJs --> scheduleJs
    registerJs --> scheduleGridJs
    registerJs --> registerGridViewJs
    registerGridViewJs --> scheduleJs
    registerGridViewJs --> scheduleGridJs
    adminJs --> authJs
    adminJs --> dbJs
    adminJs --> scheduleJs
    historyJs --> authJs
    historyJs --> dbJs
    historyJs --> scheduleJs
    historyJs --> overviewViewJs
    overviewViewJs --> dbJs
    overviewViewJs --> scheduleJs
    authJs --> dbJs
    dbJs --> scheduleMergeJs
    dailyRecordJs --> dbJs
    dailyRecordJs --> scheduleJs
    dailyRecordJs --> careReconcileJs
    scheduleGridJs --> scheduleJs

    %% ===== 汎用ユーティリティ呼び出し(点線・補助的) =====
    careJs -.-> toastJs
    careJs -.-> swipeJs
    careJs -.-> escJs
    careJs -.-> iconsJs
    runJs -.-> toastJs
    runJs -.-> swipeJs
    runJs -.-> escJs
    runJs -.-> iconsJs
    registerGridViewJs -.-> escJs
    adminJs -.-> iconsJs
    overviewViewJs -.-> escJs

    classDef screen fill:#F5C4B3,stroke:#B4B2A9,color:#222
    classDef viewpart fill:#FADCC9,stroke:#B4B2A9,color:#222
    classDef util fill:#E4E4E0,stroke:#B4B2A9,color:#222
    classDef logic fill:#CECBF6,stroke:#B4B2A9,color:#222
    classDef pure fill:#FFF3B0,stroke:#B4B2A9,color:#222
    classDef data fill:#9FE1CB,stroke:#B4B2A9,color:#222

    class loginJs,mainJs,careJs,runJs,registerJs,adminJs,historyJs screen
    class overviewViewJs,registerGridViewJs viewpart
    class escJs,swipeJs,toastJs,iconsJs util
    class authJs,scheduleJs,scheduleGridJs,dailyRecordJs logic
    class scheduleMergeJs,careReconcileJs pure
    class dbJs data
