digraph G {
  // 階層(画面層→画面部品/小さな共通部品→共通ロジック層→純粋モジュール→データアクセス層)を
  // clusterで明示したレイアウト。詳細は function_relationships.md が正。
  // 実線=業務ロジックの本流の依存／点線=esc.js等の汎用ユーティリティ呼び出し(横断的・補助的)
  rankdir=TB;
  bgcolor="white";
  fontname="Noto Sans CJK JP";
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11, color="#B4B2A9"];
  edge [fontname="Noto Sans CJK JP", fontsize=10, color="#5F5E5A"];

  subgraph cluster_screen {
    label="画面層"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#F5C4B3"];
    loginJs [label="login.js\nログイン画面"];
    mainJs [label="main.js\n全体一覧・メニュー・店舗切替"];
    careJs [label="care.js\nケア担当画面"];
    runJs [label="run.js\nラン担当画面・LINE送信"];
    registerJs [label="register.js\nうさぎ登録・編集"];
    adminJs [label="admin.js\n設定画面"];
    historyJs [label="history.js\n過去の記録(閲覧専用)"];
    { rank=same; loginJs; mainJs; careJs; runJs; registerJs; adminJs; historyJs; }
  }

  subgraph cluster_viewpart {
    label="画面部品(複数/専用画面で共用)"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#FADCC9"];
    overviewViewJs [label="overviewView.js\nグリッド描画(共用部品)"];
    registerGridViewJs [label="registerGridView.js\nSTEP2グリッド(register専用)"];
    { rank=same; overviewViewJs; registerGridViewJs; }
  }

  subgraph cluster_util {
    label="小さな共通部品(ドメイン知識なし)"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#E4E4E0"];
    escJs [label="esc.js\nHTMLエスケープ"];
    swipeJs [label="swipe.js\nスワイプ判定"];
    toastJs [label="toast.js\n失敗トースト"];
    iconsJs [label="icons.js\nSVGアイコン"];
    { rank=same; escJs; swipeJs; toastJs; iconsJs; }
  }

  subgraph cluster_logic {
    label="共通ロジック層"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#CECBF6"];
    authJs [label="auth.js\n認証・設定パスワード照合"];
    scheduleJs [label="schedule.js\n日付計算・状態判定(純粋)"];
    scheduleGridJs [label="scheduleGrid.js\n予定⇄グリッド変換(純粋)"];
    dailyRecordJs [label="dailyRecord.js\n当日記録の生成・更新"];
    { rank=same; authJs; scheduleJs; scheduleGridJs; dailyRecordJs; }
  }

  subgraph cluster_data {
    label="データアクセス層"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#9FE1CB"];
    dbJs [label="db.js\nFirestoreの読み書き"];
  }

  subgraph cluster_pure {
    label="純粋モジュール(テスト対象)"; style=filled; fillcolor="#FCF8E3"; fontsize=13;
    node [fillcolor="#FFF3B0"];
    scheduleMergeJs [label="scheduleMerge.js\n予定の3-wayマージ(純粋)"];
    careReconcileJs [label="careReconcile.js\n記録を予定へ整合(純粋)"];
    { rank=same; scheduleMergeJs; careReconcileJs; }
  }

  // ===== 業務ロジックの本流(実線) =====
  loginJs -> authJs;
  mainJs -> authJs;
  mainJs -> overviewViewJs;
  careJs -> authJs;
  careJs -> dbJs;
  careJs -> dailyRecordJs;
  careJs -> scheduleJs;
  careJs -> overviewViewJs;
  runJs -> authJs;
  runJs -> dbJs;
  runJs -> dailyRecordJs;
  runJs -> scheduleJs;
  runJs -> overviewViewJs;
  registerJs -> authJs;
  registerJs -> dbJs;
  registerJs -> dailyRecordJs;
  registerJs -> scheduleJs;
  registerJs -> scheduleGridJs;
  registerJs -> registerGridViewJs;
  registerGridViewJs -> scheduleJs;
  registerGridViewJs -> scheduleGridJs;
  adminJs -> authJs;
  adminJs -> dbJs;
  adminJs -> scheduleJs;
  historyJs -> authJs;
  historyJs -> dbJs;
  historyJs -> scheduleJs;
  historyJs -> overviewViewJs;
  overviewViewJs -> dbJs;
  overviewViewJs -> scheduleJs;
  authJs -> dbJs;
  dbJs -> scheduleMergeJs;
  dailyRecordJs -> dbJs;
  dailyRecordJs -> scheduleJs;
  dailyRecordJs -> careReconcileJs;
  scheduleGridJs -> scheduleJs;

  // ===== 汎用ユーティリティ呼び出し(点線・補助的) =====
  edge [style=dashed, color="#8A8A86"];
  careJs -> toastJs;
  careJs -> swipeJs;
  careJs -> escJs;
  careJs -> iconsJs;
  runJs -> toastJs;
  runJs -> swipeJs;
  runJs -> escJs;
  runJs -> iconsJs;
  registerGridViewJs -> escJs;
  adminJs -> iconsJs;
  overviewViewJs -> escJs;
}
