digraph G {
  rankdir=TB;
  bgcolor="white";
  fontname="Noto Sans CJK JP";
  node [shape=plaintext, fontname="Noto Sans CJK JP"];
  edge [fontname="Noto Sans CJK JP", fontsize=10, color="#5F5E5A"];

  // 改訂3:実装に合わせて関数一覧・引数・呼び出し関係を更新

  authJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#CECBF6"><FONT POINT-SIZE="13"><B>auth.js</B></FONT><BR/><FONT POINT-SIZE="10">共通ロジック層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">login(inputPassword)</FONT><BR/><FONT POINT-SIZE="9">パスワード照合し匿名ログイン、roleを返す</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">signInAnonymously()</FONT><BR/><FONT POINT-SIZE="9">匿名ログインを実行する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">requireAuth(onReady)</FONT><BR/><FONT POINT-SIZE="9">各画面の認証ガード</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getRole() / isManager()</FONT><BR/><FONT POINT-SIZE="9">保存したroleを参照する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">logout()</FONT><BR/><FONT POINT-SIZE="9">ログアウトしてlogin.htmlへ戻す</FONT></TD></TR>
    </TABLE>
  >];

  scheduleJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#CECBF6"><FONT POINT-SIZE="13"><B>schedule.js</B></FONT><BR/><FONT POINT-SIZE="10">共通ロジック層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">calculateDefaultCareDate(pickupDate, holidays)</FONT><BR/><FONT POINT-SIZE="9">お迎え日から逆算しケア日を決める</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">calculatePhotoNeeded(date, careSchedule, runSchedule, holidays)</FONT><BR/><FONT POINT-SIZE="9">写真が必要な日か自動判定する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">日付ユーティリティ</FONT><BR/><FONT POINT-SIZE="9">toISO/parseISO/addDays/eachDate/formatJP/isHoliday</FONT></TD></TR>
    </TABLE>
  >];

  dailyRecordJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#CECBF6"><FONT POINT-SIZE="13"><B>dailyRecord.js</B></FONT><BR/><FONT POINT-SIZE="10">共通ロジック層 ― 引数は (storeId, rabbit, date, ...)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getOrCreateDailyRecord()</FONT><BR/><FONT POINT-SIZE="9">当日の記録が無ければ作る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updateCareItem()</FONT><BR/><FONT POINT-SIZE="9">ケア項目1つの実施を記録する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">addCareItemForToday()</FONT><BR/><FONT POINT-SIZE="9">その日だけ項目を追加する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">removeCareItemForToday()</FONT><BR/><FONT POINT-SIZE="9">その日だけ項目を即時削除する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">markCareLineSent()</FONT><BR/><FONT POINT-SIZE="9">ケアのLINE送信済みにする</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updateRunCheck()</FONT><BR/><FONT POINT-SIZE="9">ランの実施回数を更新する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">markRunLineSent()</FONT><BR/><FONT POINT-SIZE="9">ラン1回分を送信済みにする</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updatePhotoStatus()</FONT><BR/><FONT POINT-SIZE="9">写真の状態を更新する</FONT></TD></TR>
    </TABLE>
  >];

  dbJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#9FE1CB"><FONT POINT-SIZE="13"><B>db.js</B></FONT><BR/><FONT POINT-SIZE="10">データアクセス層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getConfig()</FONT><BR/><FONT POINT-SIZE="9">共通/店長パスワードを取得する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">saveRabbit() / getRabbit()</FONT><BR/><FONT POINT-SIZE="9">うさぎ情報を保存/一度だけ取得する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">subscribeRabbit()</FONT><BR/><FONT POINT-SIZE="9">うさぎ文書1件をリアルタイム購読する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">subscribeActiveRabbits() / getAllRabbits()</FONT><BR/><FONT POINT-SIZE="9">うさぎ一覧を購読/全件取得する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">writeDailyRecord()</FONT><BR/><FONT POINT-SIZE="9">dailyRecordsフィールドを部分更新する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">bumpTotals()</FONT><BR/><FONT POINT-SIZE="9">careTotals/runTotalを増減する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">deleteCareItemForDate()</FONT><BR/><FONT POINT-SIZE="9">その日のケア項目を1つ削除する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">writeSchedules()</FONT><BR/><FONT POINT-SIZE="9">予定(care/run/photo)をまとめて保存する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getCareItemsMaster() / updateCareItemsMaster()</FONT><BR/><FONT POINT-SIZE="9">ケア項目マスタ(店舗文書の配列フィールド)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getHolidays() / updateHolidays()</FONT><BR/><FONT POINT-SIZE="9">定休日 { weekdays, dates }</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">updatePhotoScheduleRange()</FONT><BR/><FONT POINT-SIZE="9">複数日の写真要否を編集する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">hideRabbit() / unhideRabbit()</FONT><BR/><FONT POINT-SIZE="9">非表示にしTTL起点(expireAt)を記録/取り消す</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">initConfig() / initStore()</FONT><BR/><FONT POINT-SIZE="9">初期セットアップ用</FONT></TD></TR>
    </TABLE>
  >];

  loginJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>login.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onLoginSubmit()</FONT><BR/><FONT POINT-SIZE="9">パスワード送信を受け取る</FONT></TD></TR>
    </TABLE>
  >];

  mainJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>main.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">requireAuth() / isManager()</FONT><BR/><FONT POINT-SIZE="9">店長なら店長設定リンクを表示</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">logout()</FONT><BR/><FONT POINT-SIZE="9">ログアウトボタン</FONT></TD></TR>
    </TABLE>
  >];

  careJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>care.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onCheckboxClick()</FONT><BR/><FONT POINT-SIZE="9">チェック操作を受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onAddItemForToday()</FONT><BR/><FONT POINT-SIZE="9">追加(セレクト)を受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onDeleteItemForToday()</FONT><BR/><FONT POINT-SIZE="9">削除(ボタン)を受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onSwipeComplete()</FONT><BR/><FONT POINT-SIZE="9">LINE送信ボタンを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onPhotoCheck()</FONT><BR/><FONT POINT-SIZE="9">写真チェックを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">render()</FONT><BR/><FONT POINT-SIZE="9">画面を表示し購読を開始する</FONT></TD></TR>
    </TABLE>
  >];

  runJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>run.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onRunCheckToggle()</FONT><BR/><FONT POINT-SIZE="9">ラン実施チェックを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onRunSwipeSent()</FONT><BR/><FONT POINT-SIZE="9">ラン送信ボタンを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onPhotoCheck()</FONT><BR/><FONT POINT-SIZE="9">写真チェックを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">render()</FONT><BR/><FONT POINT-SIZE="9">画面を表示し購読を開始する</FONT></TD></TR>
    </TABLE>
  >];

  registerJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>register.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onSubmit()</FONT><BR/><FONT POINT-SIZE="9">登録/編集フォームを受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onAddAnotherRabbit()</FONT><BR/><FONT POINT-SIZE="9">同グループで続けて登録する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onSaveSchedule()</FONT><BR/><FONT POINT-SIZE="9">宿泊全体の予定を保存する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onHideRabbit()</FONT><BR/><FONT POINT-SIZE="9">宿泊終了(非表示)にする</FONT></TD></TR>
    </TABLE>
  >];

  overviewJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>overview.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">render()</FONT><BR/><FONT POINT-SIZE="9">一覧を表示する</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">getCellStatus()</FONT><BR/><FONT POINT-SIZE="9">予定か実績かを判定し表示する(記録は生成しない)</FONT></TD></TR>
    </TABLE>
  >];

  adminJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>admin.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層(店長のみ)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onUpdateCareItemsMaster()</FONT><BR/><FONT POINT-SIZE="9">マスタ編集を受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onUpdateHolidays()</FONT><BR/><FONT POINT-SIZE="9">定休日編集を受け取る</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onUpdatePhotoScheduleRange()</FONT><BR/><FONT POINT-SIZE="9">写真の一括編集を受け取る</FONT></TD></TR>
    </TABLE>
  >];

  historyJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>history.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">loadPastRecords()</FONT><BR/><FONT POINT-SIZE="9">過去記録の参照を受け取る</FONT></TD></TR>
    </TABLE>
  >];

  setupJs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B4B2A9">
      <TR><TD BGCOLOR="#F5C4B3"><FONT POINT-SIZE="13"><B>setup.js</B></FONT><BR/><FONT POINT-SIZE="10">画面層(初回のみ)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">onSubmit()</FONT><BR/><FONT POINT-SIZE="9">初期値の投入を受け取る</FONT></TD></TR>
    </TABLE>
  >];

  loginJs -> authJs;
  mainJs -> authJs;
  careJs -> authJs;
  runJs -> authJs;
  registerJs -> authJs;
  overviewJs -> authJs;
  adminJs -> authJs;
  historyJs -> authJs;
  setupJs -> authJs;
  authJs -> dbJs;
  careJs -> dailyRecordJs;
  runJs -> dailyRecordJs;
  careJs -> dbJs;
  runJs -> dbJs;
  registerJs -> scheduleJs;
  overviewJs -> scheduleJs;
  dailyRecordJs -> scheduleJs;
  dailyRecordJs -> dbJs;
  registerJs -> dbJs;
  overviewJs -> dbJs;
  adminJs -> dbJs;
  historyJs -> dbJs;
  setupJs -> dbJs;
}
