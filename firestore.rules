rules_version = '2';

// うさぎホテル業務管理アプリ
// 方針：本物のメール/パスワードでログイン済みのユーザーだけが読み書きできる。
//       スタッフは Firebase Authentication に1つだけ作った共有アカウントでログインする
//       （匿名認証は使わない）。パスワード画面はあくまで入口で、技術的な防御はこのルール。
//
// スキーマ検証：他画面がクラッシュしないよう、書き込み後の文書の「型」を最小限チェックする。
//   ・厳しすぎて正常な書き込みを弾かないよう、任意フィールドの欠落・追加フィールド・null は許容。
//   ・dailyRecords の中身（日付ごとの深いマップ）までは検証しない。

service cloud.firestore {
  match /databases/{database}/documents {

    // メール/パスワードでログイン済みか（匿名・カスタム等は不可）
    function staff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function optDate(d, k) {
      return !(k in d) || (d[k] is string && d[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function optStr(d, k) {
      return !(k in d) || d[k] == null || d[k] is string;
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function optMap(d, k) {
      return !(k in d) || d[k] is map;
    }

    // 設定パスワード（managerPassword）だけを置く文書。
    // get：設定画面のパスワード照合に必要（ログイン済みスタッフのみ）
    // 作成：まだ存在しない場合のみ（初回セットアップ時、Firestoreコンソールから作成）。フィールドは managerPassword のみ。
    // 更新・削除：クライアントからは不可（変更は Firebase コンソールで）
    match /config/{doc} {
      allow get: if staff();
      allow list: if false;
      allow create: if staff()
        && !exists(/databases/$(database)/documents/config/$(doc))
        && request.resource.data.keys().hasOnly(['managerPassword'])
        && request.resource.data.managerPassword is string;
      allow update, delete: if false;
    }

    // 店舗設定
    match /stores/{storeId} {
      function validStore() {
        let d = request.resource.data;
        return (!('name' in d) || d.name is string)
          && (!('holidays' in d) || d.holidays is map)
          && (!('careItemsMaster' in d) || d.careItemsMaster is list)
          && (!('busyPeriods' in d) || d.busyPeriods is list);
      }
      allow get, list: if staff();
      allow create, update: if staff() && validStore();
      allow delete: if false;

      // うさぎの宿泊記録
      // list を明示的に許可：ケア/ラン/一覧画面は subscribeActiveRabbits() で
      // コレクションをクエリ購読するため、get だけでは一覧取得が弾かれる。
      match /rabbits/{rabbitId} {
        // 全画面が名前を必ず参照する（esc / 並べ替え）。ここが文字列なら描画は壊れない。
        // それ以外は「あれば型が正しいこと」を確認する程度（欠落・null・追加フィールドは許容）。
        function validRabbit() {
          let d = request.resource.data;
          return d.ownerLastName is string
            && d.rabbitName is string
            && optDate(d, 'checkInDate')
            && optDate(d, 'checkOutDate')
            && optMap(d, 'careSchedule')
            && optMap(d, 'careCounts')
            && optMap(d, 'runSchedule')
            && optMap(d, 'dailyRecords')
            && optStr(d, 'note')
            && optStr(d, 'groupId')
            && optStr(d, 'staffName')
            && optBool(d, 'isFirstTime')
            && optBool(d, 'transportDropoff')
            && optBool(d, 'transportPickup');
        }
        allow get, list: if staff();
        allow create, update: if staff() && validRabbit();
        allow delete: if staff();
      }
    }
  }
}
